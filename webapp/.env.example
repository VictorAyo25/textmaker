# Copy to .env.local for local development. Every one of these is OPTIONAL:
# with none of them set the app still runs and marks, it just keeps history in
# the browser instead of your account. See SETUP.md.

# --- Google sign-in (Step 2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32
NEXTAUTH_SECRET=
# Only needed locally. Vercel provides this on its own domains.
NEXTAUTH_URL=http://localhost:3000

# --- Supabase, for cross-device results (Step 3) ---
NEXT_PUBLIC_SUPABASE_URL=
# Server-only. Never rename this to start with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
