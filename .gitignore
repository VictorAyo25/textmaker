# Build outputs — all regenerated by `cd courses/<COURSE>/build && python assemble.py`
courses/*/build/full_manual.html
courses/*/build/full_manual.pdf
courses/*/build/full_manual_clean.pdf
courses/*/build/cover.pdf
courses/*/build/module5.html
courses/*/build/recon_test.html
courses/*/build/svg_test.html
courses/*/build/test.html
courses/*/build/test.pdf
courses/*/build/*.png
courses/*/build/survey_out.txt
courses/*/build/struct_out.txt
courses/*/build/__pycache__/
courses/*/build/.build.lock

# NOTE: courses/*/build/content/ IS tracked — it holds the frozen, editable
# prose for Foundations and Modules 1-4, plus content/assets/*.png. Do not ignore it.

# Work in progress. The signed-off PDF lives in FINAL_MANUALS/ instead.
courses/*/drafts/

# Redundant original archive (its extracted contents are tracked in sources/)
courses/*/sources/**/_original_delivery_*.zip

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store
.vscode/
